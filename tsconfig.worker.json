{
  "extends": "./tsconfig.front.json",
  "compilerOptions": {
    // 参照ライブラリをWeb Worker用にする
    "lib": ["webworker"],
    // tsconfig.front.jsonから参照する
    "declaration": true,
    "composite": true
  },
  // TODO: 適宜Web Worker用にビルドするTSファイルを追加していく
  "include": ["ch0*/**/*.ts"],
  "exclude": ["ch0*/**/*.spec.ts", "ch0*/**/*.test.ts", "ch0*/**/*.worker.ts"]
}
