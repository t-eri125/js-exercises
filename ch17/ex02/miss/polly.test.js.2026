/**
 * Polly.JS を用いて、最初の一回だけ GitHub の API と通信し、
 * そのインタラクションを記録して、次回以降は記録されたレスポンスをリプレイする方法
 */
const path = require("path");
const { Polly } = require("@pollyjs/core");
const FetchAdapter = require("@pollyjs/adapter-fetch"); // fetch を捕まえるためのアダプタ
const FSPersister = require("@pollyjs/persister-fs");   // 記録データをローカルファイルに保存するための persister

const { createIssue, closeIssue, listIssues } = require("../index.js");

// Pollyに使用するアダプタと保存方法を登録する（やらないと Polly は動かない）
Polly.register(FetchAdapter);
Polly.register(FSPersister);

describe("Polly.JS を用いた Issue テスト", () => {
    const recordingsDir = path.join(__dirname, "recordings");

    // テストはダミー値
    const owner = "test-owner";
    const repo = "test-repo";
    const token = "test-token";

    let polly;

    function setupPolly(name) {

        // Polly インスタンスを作成する
        //  adapters: fetch のみを監視
        //  persister: 記録データをファイル保存
        //  mode
        //      replay-if-missing: 録音が無ければ実通信して記録（デフォルト）
        //      replay: 記録のみ使う
        polly = new Polly(name, {
            adapters: ["fetch"],
            persister: "fs",
            mode: "replay" // 一応
        });
        return polly;
    }

    afterEach(async () => {
        if (polly) {
            await polly.stop();
            polly = null;
        }
    });
    test("Create をリプレイする", async () => {
        polly = setupPolly("Create");
        const { server } = polly;

        // fetchAdapter を用いて、特定のリクエストに対してレスポンスを返すようにする
        server
            .post(`https://api.github.com/repos/${owner}/${repo}/issues`)
            .intercept((req, res) => {
                res.status(201).json({ number: 1, title: "test01" });
            });

        const result = await createIssue(owner, repo, "test01", token);
        expect(result.title).toBe("test01");
    });

    test("Close をリプレイする", async () => {
        polly = setupPolly("Close");
        const { server } = polly;

        server
            .patch(`https://api.github.com/repos/${owner}/${repo}/issues/1`)
            .intercept((req, res) => {
                res.status(200).json({ state: "closed" });
            });

        const result = await closeIssue(owner, repo, 1, token);
        expect(result.state).toBe("closed");
    });

    test("List をリプレイする", async () => {
        polly = setupPolly("List");
        const { server } = polly;

        server
            .get(`https://api.github.com/repos/${owner}/${repo}/issues`)
            .intercept((req, res) => {
                res.status(200).json([
                    { number: 1, title: "test01" }
                ]);
            });

        const result = await listIssues(owner, repo, token);
        expect(result).toEqual([
            { number: 1, title: "test01" }
        ]);
    });
});
